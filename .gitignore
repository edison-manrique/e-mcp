# --- Zig: cache y salidas de build (nunca al repo) ---
.zig-cache/
.zig-cache-*/
zig-cache/
zig-out/
zig-out-*/

# --- Binarios y artefactos compilados (cualquier carpeta) ---
*.exe
*.pdb
*.obj
*.o
*.a
*.lib
*.dll
*.so
*.dylib
*.ilk
*.exp

# --- Secretos locales: NUNCA al repo ---
# .secrets/ guarda la clave privada del creador usada para firmar registros.
# Protegido ademas con ACL de Windows (solo el usuario actual).
.secrets/
.secrets/**
*.key
*.pem
*.p12
*.pfx

# --- emcp: MCPs registrados ---
# Se ignora su contenido (binarios copiados/descargados) pero se conserva el indice.
# Ruta anclada a la raiz: con "mcps/*/" el patron no casaba "emcp/mcps/*/".
emcp/mcps/*/
emcp/mcps/.stage/

# --- mcp-proxy: temporales de escaneo (se borran solos) ---
mcp-proxy/data/tmp/

# --- Node / Bun ---
node_modules/

# --- Python (bindings de mcp-ml) ---
__pycache__/
*.pyc
.venv/
venv/

# --- Sistema / editor ---
Thumbs.db
Desktop.ini
.DS_Store
*.swp
*~

# --- mcp-vault: bovedas locales (nunca al repo) ---
*.evlt
*.evlt.*
boveda/
